# -------------------------------------------------------
# Office Task Management System — Environment Variables
# Copy this file to .env and fill in your values
# Place .env inside /var/www/office-tasks/server/
# -------------------------------------------------------

# Node environment (keep as production)
NODE_ENV=production

# Port the Node.js server listens on (nginx proxies to this)
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://office_user:strongpassword@localhost:5432/office_tasks
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/office_tasks

# JWT secret — use a long random string (minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
